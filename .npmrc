# Sencha's packages run install scripts that fail on Windows with current Node.js (spawn EINVAL).
# They are not needed: tools/cmd-setup.js installs the Sencha Cmd binaries on first build.
ignore-scripts=true

# Always use the public npm registry for Sencha packages, even if your user .npmrc points the @sencha scope
# at Sencha's private registry (npm.sencha.com), where these exact versions are not published.
@sencha:registry=https://registry.npmjs.org/
