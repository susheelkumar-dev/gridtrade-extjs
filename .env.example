# GridTrade API container settings (set these as secrets on Azure Container Apps)
PORT=8080
# >= 32 characters. The portfolio uses the same value (GridTrade:JwtSecret) to verify tokens for menu filtering.
GT_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Password for every seeded user that has no entry in GT_SEED_PASSWORDS. Keep it secret.
GT_SEED_PASSWORD=change-me
# Public read-only demo login shown on the portfolio page
GT_SEED_PASSWORDS={"auditor":"GridTrade-Demo-2026"}
GT_JWT_TTL_MINUTES=30
